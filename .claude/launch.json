{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend (uvicorn)",
      "runtimeExecutable": "backend/venv/bin/uvicorn",
      "runtimeArgs": ["main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--app-dir", "backend"],
      "port": 8000
    },
    {
      "name": "frontend (vite)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 5173
    }
  ]
}
